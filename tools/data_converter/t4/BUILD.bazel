load("@ncore_pip_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//bazel/pytest:defs.bzl", "pytest_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "pylib",
    srcs = ["pcd.py"],
    deps = [
        requirement("numpy"),
    ],
)

py_binary(
    name = "convert",
    srcs = ["converter.py"],
    main = "converter.py",
    deps = [
        ":pylib",
        "//ncore:pylib",
        "//tools/data_converter:pylib_cli",
        requirement("click"),
        requirement("numpy"),
        requirement("t4-devkit"),
        requirement("tqdm"),
        requirement("universal-pathlib"),
    ],
)

alias(
    name = "t4",
    actual = ":convert",
)

pytest_test(
    name = "test",
    srcs = ["test_pcd.py"],
    deps = [
        ":pylib",
        requirement("numpy"),
    ],
)
